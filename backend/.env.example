# ── MCP server the backend calls ─────────────────────────────────────────────
# local: http://localhost:8000/mcp   docker: http://order-mcp:8000/mcp (set by compose)
ORDER_MCP_URL=http://localhost:8000/mcp

# Docker Compose injects this value from the root .env file; it must match the MCP server key.
MCP_API_KEY=your-mcp-api-key

# ── LLM provider: groq | ollama ──────────────────────────────────────────────
LLM_PROVIDER=groq

# groq (only needed when LLM_PROVIDER=groq)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# ollama (only needed when LLM_PROVIDER=ollama)
# docker: use http://host.docker.internal:11434 (compose sets this automatically)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1024
OLLAMA_NUM_THREAD=8
